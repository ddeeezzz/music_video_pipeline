{
  "paths": {
    "runs_dir": "runs",
    "default_audio_path": "resources/tots01.m4a"
  },
  "ffmpeg": {
    "ffmpeg_bin": "ffmpeg",
    "ffprobe_bin": "ffprobe",
    "video_codec": "libx264",
    "audio_codec": "aac",
    "fps": 24,
    "video_preset": "veryfast",
    "video_crf": 24,
    "render_batch_size": 1,
    "render_workers": 1,
    "video_accel_mode": "cpu_only",
    "concat_video_mode": "copy",
    "concat_copy_fallback_reencode": true
  },
  "logging": {
    "level": "INFO"
  },
  "render": {
    "video_width": 640,
    "video_height": 360
  },
  "module_b": {
    "llm": {
      "provider": "siliconflow",
      "base_url": "https://api.siliconflow.cn/v1",
      "model": "Qwen/Qwen2.5-32B-Instruct",
      "api_key_file": ".secrets/siliconflow_api_key.txt",
      "timeout_seconds": 120.0,
      "temperature": 0.7,
      "top_p": 0.9,
      "retry_times": 1,
      "max_tokens": 8192
    }
  },
  "module_c": {
    "render_backend": "comfyui",
    "render_workers": 1,
    "unit_retry_times": 1
  },
  "module_d": {
    "render_backend": "comfyui",
    "segment_workers": 1,
    "unit_retry_times": 1
  },
  "comfyui": {
    "root_dir": "G:/ComfyUI",
    "server_url": "http://127.0.0.1:8188",
    "request_timeout_seconds": 30.0,
    "poll_interval_seconds": 1.0,
    "execution_timeout_seconds": 60.0
  },
  "cross_module": {
    "global_render_limit": 1,
    "scheduler_tick_ms": 100,
    "adaptive_window": {
      "enabled": false,
      "probe_interval_ms": 1500,
      "low_watermark": 0.65,
      "high_watermark": 0.92,
      "c_gpu_index": 0,
      "d_gpu_index": 0,
      "c_limit_min": 1,
      "c_limit_max": 1,
      "d_limit_min": 1,
      "d_limit_max": 1
    }
  },
  "monitoring": {
    "max_wait_after_terminal_minutes": 30.0
  },
  "bypy_upload": {
    "enabled": false,
    "bypy_bin": "bypy",
    "remote_runs_dir": "/runs",
    "retry_times": 2,
    "timeout_seconds": 1800.0,
    "config_dir": "~/.bypy",
    "require_auth_file": false
  },
  "module_a": {
    "mode": "real_auto",
    "lyric_beat_snap_threshold_ms": 200,
    "instrumental_labels": [
      "intro",
      "outro",
      "inst"
    ],
    "fallback_enabled": true,
    "device": "auto",
    "funasr_language": "auto",
    "funasr_model": "FunAudioLLM/Fun-ASR-Nano-2512",
    "vad_model": "iic/speech_fsmn_vad_zh-cn-16k-common-pytorch",
    "demucs_model": "htdemucs",
    "comma_pause_seconds": 0.45,
    "long_pause_seconds": 0.8,
    "merge_gap_seconds": 0.25,
    "max_visual_unit_seconds": 6.0,
    "content_role_tiny_merge_bars": 0.9,
    "long_lyric_resplit_max_bars": 2.0,
    "long_other_split_min_bars": 1.0,
    "major_split_step_bars": 2.5,
    "visual_lead_seconds": 0.06,
    "implementation": "v2"
  }
}
